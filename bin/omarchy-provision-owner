#!/bin/bash

# omarchy:summary=First-boot provisioning: create the user on a machine installed in deferred provisioning
# omarchy:requires-sudo=true
# omarchy:hidden=true

# Runs on tty1 via omarchy-provision-owner.service when /var/lib/omarchy/provisioning/pending
# exists — the state a deferred-provisioning ISO install or omarchy-system-factory-reset leaves
# behind. Asks for the user (the configurator's Step 2), creates it with the
# groups system setup recorded, finalizes it offline, re-keys LUKS from the
# throwaway install passphrase to the user's password, and hands off to SDDM.
# A platform whose boot package owns its boot chain prepares it, drops the
# install key's unlock from it and records the kept key slot through
# omarchy-lifecycle-dispatch.

set -euo pipefail

PROVISIONING_DIR=/var/lib/omarchy/provisioning
IMAGER_STATE_DIR="$PROVISIONING_DIR/imager"
LOG_FILE=/var/log/omarchy-provision-owner.log
password_encrypted=false
passwordless_sudo=false
imager_preseeded=false
imager_ssh_enabled=false
imager_ssh_password_auth=false

if (( EUID != 0 )); then
  echo "Error: omarchy-provision-owner must run as root" >&2
  exit 1
fi

[[ -f $PROVISIONING_DIR/pending ]] || exit 0

touch "$LOG_FILE"
chmod 600 "$LOG_FILE"

# Never set up a user on a half-wiped system: while a factory wipe is still
# pending (i.e. it failed this boot), stand down and let it retry next boot.
if [[ -f $PROVISIONING_DIR/wipe-pending ]]; then
  echo "omarchy-provision-owner: factory wipe still pending; not running user setup" >&2
  exit 1
fi

: "${OMARCHY_PATH:?The owner service must set OMARCHY_PATH to the installed checkout}"
export PATH="$OMARCHY_PATH/bin:$PATH"

REKEY_STATE=$PROVISIONING_DIR/luks-rekey.state
source "$OMARCHY_PATH/install/provisioning/luks-rekey.sh"

# The shared setup form — the same questions, prompts, and validation the ISO
# configurator's user step asks. The ISO vendors this very file out of the
# runtime package it bundles, so an install and the first boot that finishes it
# can never offer different layouts or accept different usernames.
source "$OMARCHY_PATH/install/provisioning/setup-form.sh"

# Unlike a fresh install target, this machine already has accounts; a pinned
# resume (below) bypasses the prompt entirely.
omarchy_username_taken() { getent passwd "$1" >/dev/null; }

# Raspberry Pi Imager 2.x can place rpi-preseed.toml on the FAT boot partition
# when this image is selected through its catalog. The parser stages only a
# complete, hashed-password owner configuration; partial or invalid input keeps
# this normal interactive onboarding path instead of creating a half-configured
# machine.
load_imager_preseed() {
  [[ ! -f $PROVISIONING_DIR/luks-key ]] || return 1

  local helper=/usr/bin/omarchy-rpi4-imager-preseed status=0
  [[ -x $helper ]] || helper="$OMARCHY_PATH/bin/omarchy-rpi4-imager-preseed"
  [[ -x $helper ]] || return 1
  "$helper" stage || status=$?
  (( status == 0 )) || return "$status"
  [[ -f $IMAGER_STATE_DIR/ready ]] || return 1

  username=$(<"$IMAGER_STATE_DIR/username")
  password=$(<"$IMAGER_STATE_DIR/password-hash")
  hostname=$(<"$IMAGER_STATE_DIR/hostname")
  timezone=$(<"$IMAGER_STATE_DIR/timezone")
  keyboard=$(<"$IMAGER_STATE_DIR/keymap")
  keyboard_label=$keyboard
  imager_ssh_enabled=$(<"$IMAGER_STATE_DIR/ssh-enabled")
  imager_ssh_password_auth=$(<"$IMAGER_STATE_DIR/ssh-password-auth")
  passwordless_sudo=$(<"$IMAGER_STATE_DIR/passwordless-sudo")
  password_encrypted=true
  imager_preseeded=true

  if [[ -f $IMAGER_STATE_DIR/authorized_keys ]]; then
    cp "$IMAGER_STATE_DIR/authorized_keys" "$PROVISIONING_DIR/authorized_keys"
    chmod 600 "$PROVISIONING_DIR/authorized_keys"
  fi
}

LOGO_PATH="$OMARCHY_PATH/logo.txt"
LOGO_WIDTH=$(awk '{ if (length > max) max = length } END { print max+0 }' "$LOGO_PATH" 2>/dev/null || echo 0)
LOGO_HEIGHT=$(wc -l <"$LOGO_PATH" 2>/dev/null || echo 0)
(( LOGO_WIDTH > 0 )) || LOGO_WIDTH=81
(( LOGO_HEIGHT > 0 )) || LOGO_HEIGHT=1

export GUM_CONFIRM_PROMPT_FOREGROUND="6"
export GUM_CONFIRM_SELECTED_FOREGROUND="0"
export GUM_CONFIRM_SELECTED_BACKGROUND="2"
export GUM_CONFIRM_UNSELECTED_FOREGROUND="7"
export GUM_CONFIRM_UNSELECTED_BACKGROUND="0"

# Match the first-boot console font to the ISO installer's apparent text size.
# The installer renders on GRUB's low-resolution console (gfxpayload=keep, on
# the ~768-row EFI GOP mode) where the default 8x16 font fills the screen. The
# installed system reaches native KMS resolution, where 8x16 is tiny — so
# first-boot provisioning looked far smaller than the installer it continues.
#
# Pick the kbd console font whose row count lands closest to that installer feel
# (~48 rows), but never one wide enough to wrap the 81-column logo. On a console
# that is already installer-sized (low resolution) this lands on the default
# font, i.e. a no-op. All three fonts ship with kbd, so there's no dependency.
scale_console_font() {
  [[ $(tty 2>/dev/null) == /dev/tty* ]] || return 0

  # Pick the console font empirically: apply each candidate, read the columns
  # fbcon actually hands back, and keep the one whose row count lands nearest a
  # ~48-row target while still leaving room for the 81-column logo. Measuring
  # the real result beats computing from /sys/class/graphics/fb0/virtual_size,
  # which under virgl can report a size the text console never actually reaches —
  # that mismatch is what wrapped the logo into the top-left corner.
  local target_rows=48
  local fonts=("default8x16" "sun12x22" "latarcyrheb-sun32")
  local best="" best_diff=999999 name rows cols diff
  for name in "${fonts[@]}"; do
    setfont "$name" 2>/dev/null || continue
    read -r rows cols < <(stty size </dev/tty 2>/dev/null || printf '0 0\n')
    [[ $rows =~ ^[0-9]+$ && $cols =~ ^[0-9]+$ ]] || continue
    (( cols > LOGO_WIDTH )) || continue      # must clear the 81-col logo
    diff=$(( rows > target_rows ? rows - target_rows : target_rows - rows ))
    (( diff < best_diff )) && { best_diff=$diff; best="$name"; }
  done
  # Fall back to the narrowest font if nothing cleared the logo width, so the
  # form stays usable even on an unexpectedly tiny console.
  setfont "${best:-default8x16}" 2>/dev/null || true
}

# Same Tokyo Night VT palette the ISO configurator sets, so the first-boot
# form looks like a continuation of the install.
set_tokyo_night_colors() {
  [[ $(tty 2>/dev/null) == /dev/tty* ]] || return 0
  echo -en "\e]P01a1b26"; echo -en "\e]P1f7768e"; echo -en "\e]P29ece6a"
  echo -en "\e]P3e0af68"; echo -en "\e]P47aa2f7"; echo -en "\e]P5bb9af7"
  echo -en "\e]P67dcfff"; echo -en "\e]P7a9b1d6"; echo -en "\e]P8414868"
  echo -en "\e]P9f7768e"; echo -en "\e]PA9ece6a"; echo -en "\e]PBe0af68"
  echo -en "\e]PC7aa2f7"; echo -en "\e]PDbb9af7"; echo -en "\e]PE7dcfff"
  echo -en "\e]PFc0caf5"
  echo -en "\033[0m"
  clear
}

measure_terminal() {
  TERM_WIDTH=$(stty size 2>/dev/null </dev/tty | awk '{print $2}')
  (( TERM_WIDTH > 0 )) || TERM_WIDTH=${COLUMNS:-80}

  PADDING_LEFT=$(((TERM_WIDTH - LOGO_WIDTH) / 2))
  (( PADDING_LEFT < 0 )) && PADDING_LEFT=0
  PADDING_LEFT_SPACES=$(printf "%*s" "$PADDING_LEFT" "")

  local padding="0 0 0 $PADDING_LEFT"
  export GUM_CHOOSE_PADDING="$padding"
  export GUM_FILTER_PADDING="$padding"
  export GUM_INPUT_PADDING="$padding"
  export GUM_SPIN_PADDING="$padding"
  export GUM_TABLE_PADDING="$padding"
  export GUM_CONFIRM_PADDING="$padding"
}

clear_logo() {
  measure_terminal
  printf "\033[H\033[2J"
  gum style --foreground 2 --padding "1 0 0 $PADDING_LEFT" "$(<"$LOGO_PATH")"
}

step() {
  clear_logo
  echo
  gum style --padding "0 0 0 $PADDING_LEFT" "$1"
  echo
}

say() {
  gum style --padding "0 0 0 $PADDING_LEFT" "$@"
}

notice() {
  clear_logo
  echo
  printf '%*s\033[32m● \033[0m%s\n' "$PADDING_LEFT" '' "$1"
  sleep "${2:-2}"
  echo
}

log_step() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] oem-setup: $1" >>"$LOG_FILE"
}

# ── Setup progress screen ────────────────────────────────────────────────────
#
# The ISO install dashboard's own screen, drawn by the file it vendors from this
# package, so first-boot account setup continues the install on the screen it
# started on: the same traced icon, percentage and rotating tips. Position =
# max(floor, work) in per-mille, monotonic; the floor is asymptotic per phase
# band and the work signal counts finalize-user's run_logged scripts in the log.
source "$OMARCHY_PATH/install/provisioning/progress-icon.sh"

CSI=$'\033['
RESET="${CSI}0m"
DIM="${CSI}2m"
HIDE_CURSOR="${CSI}?25l"
SHOW_CURSOR="${CSI}?25h"
CLEAR="${CSI}2J${CSI}H"
GREEN="${CSI}32m"

STATE_FILE=/run/omarchy-provision-owner.state
FINALIZE_WARNING_FLAG=$PROVISIONING_DIR/finalize-failed

tips=(
  "Super + Space opens the Omarchy menu for apps, settings, and more"
  "Super + K shows all the key bindings"
  "Super is the Windows or command key on your keyboard"
  "Sign PDFs and fill them in with Signed"
  "Share files with phones and laptops using LocalSend"
  "Turn any website into an app with Install > Web App in the menu"
  "Super + Return opens a terminal, Super + Shift + Return the browser"
  "Edit images with Pinta, trim videos with Omacut, docs with LibreOffice"
  "Super + Ctrl + Print grabs text off the screen with OCR"
  "Print takes a screenshot, Alt + Print records the screen"
  "Set a reminder with Super + Ctrl + R"
  "Switch themes from Appearance > Theme in the Omarchy menu"
  "Double-click the menu bar to make it transparent"
  "Run a full Windows VM via Install > Windows in the menu"
  "Super + Ctrl + V opens the clipboard manager"
  "Super + 1 through 0 switches workspaces, add Shift to bring the window"
  "Super + Print picks a color from anywhere on screen"
  "Keep the system fresh with Update in the Omarchy menu"
)

term_cols() {
  local cols
  cols=$(stty size 2>/dev/null </dev/tty | awk '{print $2}')
  [[ $cols =~ ^[0-9]+$ ]] && (( cols > 0 )) || cols=${COLUMNS:-80}
  printf '%s' "$cols"
}

# A fingerprint of the console geometry: the VT size plus the framebuffer's
# identity and pixel size. On a fresh first boot the VT can come up in a
# transitional ~80x25 mode and only widen to the real resolution a second or
# more later, when virtio-gpu's KMS takes over (or the SDL window's size lands).
# Watching this signature settle — rather than trusting one early reading — is
# what keeps the greeter from measuring that transient and rendering into it.
console_signature() {
  local size fb_size="" fb_name=""
  size=$(stty size 2>/dev/null </dev/tty) || return 1
  [[ $size =~ ^[0-9]+\ [0-9]+$ ]] || return 1
  [[ -r /sys/class/graphics/fb0/virtual_size ]] && fb_size=$(<"/sys/class/graphics/fb0/virtual_size")
  [[ -r /sys/class/graphics/fb0/name ]] && fb_name=$(<"/sys/class/graphics/fb0/name")
  printf '%s|%s|%s' "$size" "$fb_name" "$fb_size"
}

# Block until the console signature holds unchanged for a genuine quiet stretch
# (quiet_samples * 100ms), giving up after max_samples * 100ms. Returns 0 once
# quiet, 1 on timeout.
wait_console_stable() {
  local max_samples="${1:-100}" quiet_samples="${2:-15}"
  local previous="" current="" quiet=0 i
  for ((i = 0; i < max_samples; i++)); do
    current=$(console_signature 2>/dev/null || true)
    if [[ -n $current && $current == "$previous" ]]; then
      quiet=$((quiet + 1))
      (( quiet >= quiet_samples )) && return 0
    else
      previous=$current
      quiet=0
    fi
    sleep 0.1
  done
  return 1
}

left_padding() {
  local width="${1:-$LOGO_WIDTH}" cols pad
  cols=$(term_cols)
  pad=$(((cols - width) / 2))
  (( pad < 0 )) && pad=0
  printf '%*s' "$pad" ''
}

# Monotonic clock so an NTP step during setup cannot jump the progress.
set_now() {
  local up rest
  if read -r up rest </proc/uptime 2>/dev/null && [[ $up == [0-9]* ]]; then
    NOW=${up%%.*}
  else
    NOW=$EPOCHSECONDS
  fi
  return 0
}

# One tip per 8 seconds, elapsed-time driven like the install dashboard. It
# sets SETUP_TIP rather than printing it, so a frame forks no subshell for it.
current_tip() {
  SETUP_TIP="Tip: ${tips[(NOW - SETUP_T0) / 8 % ${#tips[@]}]}"
}

SETUP_POS=10
SETUP_PHASE=""
SETUP_PHASE_T0=0
SETUP_T0=0
NOW=0
FINALIZE_BASE=-1
FINALIZE_TOTAL=$(grep -c '^run_logged' "$OMARCHY_PATH/install/user/all.sh" 2>/dev/null || echo 0)

# Whether this boot will re-key LUKS (encrypted installs stage a throwaway key).
# The re-key rebuilds the UKI and is the slowest single step, so it needs a wide
# band of its own; unencrypted installs skip it and let finalize take the room.
REKEY_PENDING=false
[[ -f $PROVISIONING_DIR/luks-key ]] && REKEY_PENDING=true

# Per-mille bands per phase: "lo hi tau". tau shapes the asymptotic time floor;
# it is not a duration prediction. A wide band moves visibly; a narrow one looks
# stuck. Skipped phases leave a gap the next band's floor crosses on its own.
phase_band() {
  if $REKEY_PENDING; then
    # Encrypted: finalize is quick, the LUKS re-key (UKI rebuild) is the long
    # pole — give it nearly half the drawing so it keeps moving while it works.
    case $1 in
      finalize) echo "80 480 40" ;;
      rekey)    echo "480 950 30" ;;
      boot)     echo "950 990 20" ;;
      done)     echo "1000 1000 1" ;;
      *)        echo "10 80 3" ;;
    esac
  else
    # Unencrypted: finalize is the dominant step.
    case $1 in
      finalize) echo "80 900 45" ;;
      boot)     echo "900 990 20" ;;
      done)     echo "1000 1000 1" ;;
      *)        echo "10 80 3" ;;
    esac
  fi
}

setup_progress() {
  local phase lo hi tau t span floor work completed
  phase=$(cat "$STATE_FILE" 2>/dev/null || true)
  [[ -n $phase ]] || phase=account

  if [[ $phase != "$SETUP_PHASE" ]]; then
    SETUP_PHASE=$phase
    SETUP_PHASE_T0=$NOW
    FINALIZE_BASE=-1
  fi

  read -r lo hi tau <<<"$(phase_band "$phase")"
  (( lo < SETUP_POS )) && lo=$SETUP_POS

  t=$((NOW - SETUP_PHASE_T0))
  span=$((hi - lo))
  floor=$lo
  (( span > 1 )) && floor=$((lo + (span - 1) * t / (t + tau)))

  work=0
  if [[ $phase == "finalize" ]] && (( FINALIZE_TOTAL > 0 )); then
    completed=$(grep -cE '] (Completed|Failed): ' "$LOG_FILE" 2>/dev/null || true)
    [[ $completed =~ ^[0-9]+$ ]] || completed=0
    (( FINALIZE_BASE < 0 )) && FINALIZE_BASE=$completed
    completed=$((completed - FINALIZE_BASE))
    (( completed < 0 )) && completed=0
    (( completed > FINALIZE_TOTAL )) && completed=$FINALIZE_TOTAL
    work=$((lo + (hi - lo) * completed / FINALIZE_TOTAL))
  fi

  (( floor > SETUP_POS )) && SETUP_POS=$floor
  (( work > SETUP_POS )) && SETUP_POS=$work
  (( SETUP_POS > 1000 )) && SETUP_POS=1000
  return 0
}

render_setup_static() {
  printf '%s' "$HIDE_CURSOR"
  progress_icon_layout /dev/tty "$LOGO_WIDTH"
  progress_icon_static
}

# The VT can still resize under us (the same virtio-gpu KMS handoff the greeter
# watches for); progress_icon_frame redraws at the new size when it does. Only
# the worker's successful exit completes the drawing (render_setup_finish).
render_setup_dynamic() {
  local poll="${1:-1}" pm
  set_now
  (( poll )) && setup_progress
  pm=$SETUP_POS
  (( pm > 999 )) && pm=999
  current_tip
  progress_icon_frame "$pm" "Setting up your machine" "$SETUP_TIP"
}

render_setup_finish() {
  current_tip
  progress_icon_finish "Setting up your machine" "$SETUP_TIP"
}

# The first thing a new owner sees, shown once before the keyboard step:
# the logo (vertically centered like the boot logo) running a looping ColorShift,
# the Omarchy tagline, and a hint. Return skips ahead into setup at any time.
greeter_screen() {
  local anim="" drawn_sig cur_sig resized=0

  # Paint the whole splash for the console's *current* geometry. Kept in a
  # nested function so the wait loop below can repaint it verbatim if the VT
  # resizes out from under us: a late resize (virtio-gpu KMS handoff, or the SDL
  # window's size arriving) scrolls the old frame into the top-left and resets
  # the DEC saved cursor ttfx paints from — exactly the tiled/garbled logo we saw
  # on a fresh first boot. Redrawing on every resize beats any fixed-length
  # startup wait, which can only ever guess when the console has stopped moving.
  _greeter_draw() {
    local rows cols top content_h logo_row tagline_row hint_row
    local tagline hint tpad hpad pad line i

    cols=$(term_cols)
    rows=$(stty size 2>/dev/null </dev/tty | awk '{print $1}')
    [[ $rows =~ ^[0-9]+$ ]] || rows=${LINES:-24}

    tagline="Beautiful, Fun & Agentic Linux by DHH"
    hint="Press Return to Start Setup"

    printf '%s%s' "$HIDE_CURSOR" "$CLEAR"

    # Console still too narrow for the 81-column logo (a transient small mode):
    # skip the logo and animation rather than wrap them into mush — just center
    # the words. The redraw loop repaints the full splash once the VT widens.
    if (( cols <= LOGO_WIDTH )); then
      local mid=$(( rows / 2 ))
      tpad=$(( (cols - ${#tagline}) / 2 )); (( tpad < 0 )) && tpad=0
      hpad=$(( (cols - ${#hint}) / 2 )); (( hpad < 0 )) && hpad=0
      printf '%s%d;%dH%s' "$CSI" "$mid" "$((tpad + 1))" "$tagline"
      printf '%s%d;%dH%s%s%s' "$CSI" "$((mid + 2))" "$((hpad + 1))" "$DIM" "$hint" "$RESET"
      return 0
    fi

    # logo + blank + tagline + blank + hint
    content_h=$(( LOGO_HEIGHT + 4 ))
    top=$(( (rows - content_h) / 2 )); (( top < 0 )) && top=0
    logo_row=$(( top + 1 ))
    tagline_row=$(( top + LOGO_HEIGHT + 2 ))
    hint_row=$(( top + LOGO_HEIGHT + 4 ))

    # Draw each logo row at an explicit column so nothing can wrap it even if a
    # measurement is off by one; left_padding centers it for the current width.
    pad="$(left_padding "$LOGO_WIDTH")"
    i=0
    while IFS= read -r line; do
      printf '%s%d;1H%s%b%s%b' "$CSI" "$((logo_row + i))" "$pad" "$GREEN" "$line" "$RESET"
      i=$((i + 1))
    done <"$LOGO_PATH"

    tpad=$(( (cols - ${#tagline}) / 2 )); (( tpad < 0 )) && tpad=0
    printf '%s%d;%dH%s' "$CSI" "$tagline_row" "$((tpad + 1))" "$tagline"

    hpad=$(( (cols - ${#hint}) / 2 )); (( hpad < 0 )) && hpad=0
    printf '%s%d;%dH%s%s%s' "$CSI" "$hint_row" "$((hpad + 1))" "$DIM" "$hint" "$RESET"

    # ColorShift the logo: a green base (indexed color 2) with a cyan accent (6)
    # drifting through, settling on green. Indexed ANSI colors, not hex — the
    # framebuffer console can't render ttfx's truecolor faithfully (it crushes the
    # palette to a muddy lavender), but the 16 indexed colors map to the Tokyo
    # Night palette and render true. One long-running invocation (many cycles) so
    # it never restarts — a restart is what flashed. The effect reads from
    # /dev/null so it never swallows the Return the foreground read waits on;
    # --reuse-canvas paints upward from the saved cursor, anchored one row below
    # the logo to repaint exactly the rows drawn above.
    #
    # --xterm-colors is what actually keeps the palette indexed: ttfx resolves
    # even indexed stops to truecolor otherwise, and the console reduces 256-colour
    # codes well but 24-bit ones badly — that reduction is the muddy lavender.
    # It also pins the settle colour to index 2, matching the green logo drawn
    # above. --canvas-width is cols-2, not cols-1: ttfx centres its text two
    # columns right of plain centering, so cols-1 lands the animated logo a
    # column off the static one and it jumps when the effect starts.
    printf '%s%d;1H\0337' "$CSI" "$((logo_row + LOGO_HEIGHT))"
    # Run ttfx directly (not inside a `while` subshell) so $anim is ttfx's own
    # PID: killing a wrapping subshell would orphan ttfx, which then keeps
    # painting the logo over the keyboard step. --cycles is high enough that it
    # never ends on its own before Return.
    ttfx -i "$LOGO_PATH" \
      --canvas-width "$((cols > 2 ? cols - 2 : cols))" \
      --anchor-text c \
      --frame-rate 60 \
      --reuse-canvas \
      --xterm-colors \
      colorshift \
      --gradient-stops 2 10 6 10 \
      --gradient-frames 3 \
      --cycles 1000 \
      --final-gradient-stops 2 \
      </dev/null >/dev/tty 2>/dev/null &
    anim=$!
  }

  _greeter_kill_anim() {
    [[ -n ${anim:-} ]] || return 0
    # Guard both: `kill` returns non-zero if ttfx already exited (crash, or a
    # resize race), and `wait` reports ttfx's kill signal (143) — either would
    # abort provisioning under `set -e` and drop straight to the login screen.
    kill "$anim" 2>/dev/null || true
    wait "$anim" 2>/dev/null || true
    anim=""
  }

  # Let the console settle before the first paint, then size the font to it.
  wait_console_stable 100 15 || true
  scale_console_font
  wait_console_stable 30 5 || true

  trap 'resized=1' WINCH

  _greeter_draw
  drawn_sig=$(console_signature 2>/dev/null || true)

  # Wait for Return, but keep watching the geometry. On any resize (SIGWINCH or
  # a changed signature) tear the animation down, settle, re-fit the font, and
  # repaint — so a resize arriving five seconds in looks the same as one that
  # never happened.
  while true; do
    if IFS= read -r -t 0.2 _ </dev/tty; then
      break
    fi
    cur_sig=$(console_signature 2>/dev/null || true)
    if (( resized )) || [[ -n $cur_sig && $cur_sig != "$drawn_sig" ]]; then
      _greeter_kill_anim
      stty sane </dev/tty 2>/dev/null || true
      wait_console_stable 50 5 || true
      scale_console_font
      wait_console_stable 30 5 || true
      _greeter_draw
      drawn_sig=$(console_signature 2>/dev/null || true)
      # Clear last so the font-fitting's own SIGWINCHes don't re-trigger a redraw.
      resized=0
    fi
  done

  trap - WINCH
  _greeter_kill_anim
  # ttfx leaves the tty in raw/no-echo mode when killed; restore it or the gum
  # prompts in the keyboard step that follows silently die. Then clear the
  # leftover animation frame.
  stty sane </dev/tty 2>/dev/null || true
  printf '%s%s%s' "$RESET" "$CLEAR" "$SHOW_CURSOR"
}

# The keyboard step the ISO configurator runs — deferred to first boot for OEM
# installs, so the machine's owner picks their own layout. Applied immediately
# (live VT + persisted) so the password typed next, and the LUKS re-key below,
# use the chosen layout. A layout that did not take is asked for again: the
# password form must never be typed in a layout the disk unlock won't use.
# Three failures in a row mean the machine can't set a layout at all (a
# missing or broken localectl, say), so the attempt fails and setup's own
# retry-or-console screen takes over instead of asking forever.
keyboard_form() {
  local status failures=0

  while true; do
    step "Let's setup your keyboard..."
    omarchy_prompt_keyboard && status=0 || status=$?
    if ((status == 0)); then
      apply_keyboard "$keyboard" && break
      if ((++failures >= 3)); then
        log_step "no keyboard layout could be set after $failures attempts"
        notice "Setup could not set a keyboard layout on this machine." 4
        return 1
      fi
      notice "Could not set the ${keyboard_label:-$keyboard} keyboard layout. Choose it again." 4
      continue
    fi

    # Esc means "back", and nothing precedes the first screen, so re-ask.
    ((status == OMARCHY_FORM_BACK)) && continue

    # Ctrl+C is the way out of a screen the owner cannot get past. Rebooting is
    # safe but not an escape from setup: this service runs again at next boot,
    # and encrypted machines still auto-unlock from the staged keyfile until the
    # re-key below. Confirm it so a stray Ctrl+C doesn't bounce the machine.
    confirm_reboot && exec systemctl reboot
  done

  omarchy_persist_input_selection
}

confirm_reboot() {
  clear_logo
  echo
  say "Setup starts again after the reboot."
  echo
  gum confirm --affirmative "Yes, reboot" --negative "No, keep setting up" "Reboot this machine?"
}

# XKB settings for the form's keymaps that kbd-model-map lacks, as its rows for
# the nearest keymap give them, so the desktop types what the console does:
# kbd's cz is QWERTY and bg-cp1251 phonetic. Non-Latin layouts keep a US layout
# to switch to, so the shared password stays typeable.
keyboard_xkb_settings() {
  local layout variant="" options=terminate:ctrl_alt_bksp
  local switch=terminate:ctrl_alt_bksp,grp:shifts_toggle,grp_led:scroll

  case $1 in
    colemak) layout=us variant=colemak ;;
    bg-cp1251) layout=bg,us variant=phonetic, options=$switch ;;
    cz) layout=cz,us variant=qwerty, options=$switch ;;
    de_CH-latin1) layout=ch ;;
    kyrgyz) layout=kg,us options=$switch ;;
    no-latin1) layout=no ;;
    pl) layout=pl ;;
    ua) layout=ua,us options=$switch ;;
    *) return 1 ;;
  esac

  printf 'XKBLAYOUT=%s\nXKBMODEL=pc105\n' "$layout"
  [[ -z $variant ]] || printf 'XKBVARIANT=%s\n' "$variant"
  printf 'XKBOPTIONS=%s\n' "$options"
}

# Load the layout on the live VT and persist it for the installed system, or
# fail. systemd-firstboot writes both the console KEYMAP and the XKB layout
# Hyprland reads, matching what the ISO's configure_keyboard does at install
# time. The boot files ask for the disk password in the layout vconsole.conf
# names, so a keymap localectl doesn't know, a failed loadkeys, or a file that
# does not read back as the chosen keymap with an XKB layout is a failure.
apply_keyboard() {
  local keymap=$1 keymaps saved

  if [[ $(tty 2>/dev/null) == /dev/tty* ]] && ! loadkeys "$keymap" >>"$LOG_FILE" 2>&1; then
    log_step "loadkeys could not load keymap $keymap"
    return 1
  fi

  if ! keymaps=$(localectl --no-pager list-keymaps 2>>"$LOG_FILE"); then
    log_step "localectl could not list keymaps to check $keymap"
    return 1
  fi
  if ! grep -qxF -- "$keymap" <<<"$keymaps"; then
    log_step "keymap $keymap unknown to localectl"
    return 1
  fi

  if ! systemd-firstboot --keymap="$keymap" --force >>"$LOG_FILE" 2>&1 &&
    ! localectl set-keymap "$keymap" >>"$LOG_FILE" 2>&1; then
    log_step "could not persist keymap $keymap"
    return 1
  fi

  # systemd-firstboot writes an XKB layout only for keymaps in kbd-model-map,
  # and several the form offers are not, so Hyprland would come up in US.
  if ! grep -q '^XKBLAYOUT=.' /etc/vconsole.conf 2>/dev/null; then
    keyboard_xkb_settings "$keymap" >>/etc/vconsole.conf 2>>"$LOG_FILE" ||
      log_step "no XKB layout known for keymap $keymap"
  fi

  # A clean shell, so nothing this process exported stands in for the file.
  saved=$(env -i /bin/bash --noprofile --norc -c \
    '. /etc/vconsole.conf && [[ -n ${XKBLAYOUT:-} ]] && printf %s "${KEYMAP:-}"' 2>>"$LOG_FILE") || saved=""
  if [[ $saved != "$keymap" ]]; then
    log_step "/etc/vconsole.conf does not read back as keymap $keymap with an XKB layout"
    return 1
  fi
}

# The same username/password form as the ISO configurator's Step 2.
user_form() {
  step "Let's setup your user account..."

  # A prior attempt that already created the account pins the username, so a
  # retry cannot strand that account by choosing a different name.
  if [[ -f $PROVISIONING_DIR/setup-user ]]; then
    username=$(<"$PROVISIONING_DIR/setup-user")
    say "Continuing setup for user: $username"
    echo
  else
    omarchy_prompt_username || return $?
  fi

  omarchy_prompt_password || return $?

  # Hostname and timezone are deferred to first boot with the rest of the user
  # step: the deferred install seeds neutral placeholders (omarchy/UTC) and the
  # owner overwrites them here.
  omarchy_prompt_hostname || return $?

  step "Let's set your timezone..."
  omarchy_prompt_timezone || return $?
}

confirm_form() {
  clear_logo
  echo
  echo -e "Field,Value
Keyboard,${keyboard_label:-English (US)}
Username,$username
Password,$(printf "%${#password}s" | tr ' ' '*')
Hostname,${hostname:-omarchy}
Timezone,${timezone:-UTC}" |
    gum table -s "," -p | sed "s/^/${PADDING_LEFT_SPACES}/"

  echo
  gum confirm --negative "No, change it" "Does this look right?"
}

# Groups recorded by omarchy-apply-system's scripts at install time
# (/var/lib/omarchy/provisioning/groups), filtered to groups that exist on this system.
user_groups() {
  local groups="wheel" group
  if [[ -f $PROVISIONING_DIR/groups ]]; then
    while IFS= read -r group; do
      [[ -n $group ]] || continue
      # Never replay old privileged group defaults. Docker is always opt-in.
      # Input is only retained when the factory image has one of the features
      # whose installer deliberately grants access to raw input devices.
      [[ $group == "docker" ]] && continue
      if [[ $group == "input" ]] &&
        ! pacman -Qq xpadneo-dkms &>/dev/null &&
        ! pacman -Qq ydotool &>/dev/null; then
        continue
      fi
      getent group "$group" >/dev/null || continue
      [[ ",$groups," == *",$group,"* ]] || groups+=",$group"
    done <"$PROVISIONING_DIR/groups"
  fi
  echo "$groups"
}

# Resolve the crypto_LUKS partition backing the root, or return non-zero if
# the root is not on LUKS. Prefers the cmdline cryptdevice= spec (archinstall
# writes PARTUUID=, the pre-mounted path UUID=), and falls back to walking the
# device tree for roots reached via rd.luks/crypttab with a plain /dev/mapper
# root and no cryptdevice=.
luks_device() {
  local spec
  spec=$(grep -o 'cryptdevice=[^ :]*' /proc/cmdline | head -1 | cut -d= -f2-)
  case $spec in
    UUID=*) echo "/dev/disk/by-uuid/${spec#UUID=}"; return 0 ;;
    PARTUUID=*) echo "/dev/disk/by-partuuid/${spec#PARTUUID=}"; return 0 ;;
    LABEL=*) echo "/dev/disk/by-label/${spec#LABEL=}"; return 0 ;;
    PARTLABEL=*) echo "/dev/disk/by-partlabel/${spec#PARTLABEL=}"; return 0 ;;
    /dev/*) echo "$spec"; return 0 ;;
  esac

  # No cryptdevice=: walk the root source's ancestors (lsblk -s inverts the
  # tree) for the first crypto_LUKS parent.
  local src part
  src=$(findmnt -no SOURCE / | sed 's/\[.*//')
  [[ -n $src ]] || return 1
  part=$(lsblk -nsrpo NAME,FSTYPE "$src" 2>/dev/null | awk '$2=="crypto_LUKS"{print $1; exit}')
  [[ -n $part ]] && { echo "$part"; return 0; }
  return 1
}

encrypted_install() {
  luks_device >/dev/null 2>&1
}

create_user() {
  # Pin the username so a retry after a later failure resumes this exact
  # account rather than creating a second privileged one.
  echo "$username" >"$PROVISIONING_DIR/setup-user"

  if getent passwd "$username" >/dev/null; then
    # Resume an interrupted account step without creating another account.
    usermod -aG "$(user_groups)" "$username"
  else
    useradd -m -G "$(user_groups)" -s /bin/bash "$username"
  fi

  # Image builds keep the updateable port checkout in /opt. Hand it to the
  # owner created here so normal source-tracked updates can fast-forward and
  # rebuild the architecture-independent Omarchy packages without running git
  # as root.
  if [[ -d /opt/omarchy-4-pi/.git ]]; then
    chown -R "$username:$username" /opt/omarchy-4-pi
  fi

  # deferred-provisioning installs skip archinstall's create_users, which is what normally
  # uncomments %wheel in /etc/sudoers. Always write the drop-in: detecting an
  # existing grant is error-prone (omarchy ships narrow %wheel NOPASSWD rules
  # for specific commands), and a duplicate grant is harmless.
  echo "%wheel ALL=(ALL:ALL) ALL" >/etc/sudoers.d/00-omarchy-wheel
  chmod 440 /etc/sudoers.d/00-omarchy-wheel
  if $passwordless_sudo; then
    printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$username" \
      >"/etc/sudoers.d/01-omarchy-imager-$username"
    chmod 440 "/etc/sudoers.d/01-omarchy-imager-$username"
  fi

  source "$OMARCHY_PATH/install/helpers/browser-policy.sh"
  for dir in "${BROWSER_POLICY_MANAGED_DIRS[@]}"; do
    [[ -d $dir || -L $dir ]] || continue
    browser_policy_setup_dir "$dir"
  done
}

configure_password() {
  # A retry can collect a corrected password without recreating the account.
  if $password_encrypted; then
    printf '%s:%s\n' "$username" "$password" | chpasswd --encrypted
    printf '%s:%s\n' root "$password" | chpasswd --encrypted
  else
    printf '%s:%s\n' "$username" "$password" | chpasswd
    printf '%s:%s\n' root "$password" | chpasswd
  fi
}

install_authorized_keys() {
  [[ -f $PROVISIONING_DIR/authorized_keys ]] || return 0

  # Retries can reach an existing, user-controlled home. Open the staged input
  # as root, but perform every home write with the account's own privileges.
  runuser -u "$username" -- /bin/bash -euo pipefail -c '
    ssh_dir=$1
    umask 077
    if [[ -L ${ssh_dir%/.ssh} || -L $ssh_dir || -L $ssh_dir/authorized_keys ]]; then
      echo "Refusing to install authorized keys through a symlink." >&2
      exit 1
    fi
    mkdir -p "$ssh_dir"
    if [[ -e $ssh_dir/authorized_keys && $(stat -c %h "$ssh_dir/authorized_keys") != "1" ]]; then
      echo "Refusing to modify a multiply linked authorized_keys file." >&2
      exit 1
    fi
    touch "$ssh_dir/authorized_keys"
    # Keep owner-added keys and avoid joining an unterminated existing line.
    if [[ -s $ssh_dir/authorized_keys && -n $(tail -c1 "$ssh_dir/authorized_keys") ]]; then
      echo >>"$ssh_dir/authorized_keys"
    fi
    while IFS= read -r key || [[ -n $key ]]; do
      [[ -n $key ]] || continue
      grep -qxF -- "$key" "$ssh_dir/authorized_keys" || printf "%s\n" "$key" >>"$ssh_dir/authorized_keys"
    done
    chmod 700 "$ssh_dir"
    chmod 600 "$ssh_dir/authorized_keys"
  ' bash "/home/$username/.ssh" <"$PROVISIONING_DIR/authorized_keys"
}

configure_imager_network() {
  $imager_preseeded || return 0

  local connection=/etc/NetworkManager/system-connections/omarchy-imager.nmconnection
  if [[ -f $connection ]]; then
    chown root:root "$connection"
    chmod 600 "$connection"
    nmcli connection reload >>"$LOG_FILE" 2>&1 || true
  fi

  if [[ -f /etc/conf.d/wireless-regdom ]] && command -v iw >/dev/null 2>&1; then
    local country
    country=$(sed -n 's/^WIRELESS_REGDOM="\([A-Z][A-Z]\)"$/\1/p' /etc/conf.d/wireless-regdom)
    [[ -z $country ]] || iw reg set "$country" >>"$LOG_FILE" 2>&1 || true
  fi
}

configure_imager_ssh() {
  $imager_preseeded && $imager_ssh_enabled || return 0

  local key config=/etc/ssh/sshd_config.d/10-omarchy-imager.conf
  if ! $imager_ssh_password_auth; then
    [[ -s /home/$username/.ssh/authorized_keys ]] || return 1
    while IFS= read -r key; do
      [[ -z $key ]] && continue
      ssh-keygen -lf /dev/stdin <<<"$key" >/dev/null 2>&1 || return 1
    done </home/$username/.ssh/authorized_keys
  fi

  install -d -m 755 /etc/ssh/sshd_config.d
  if $imager_ssh_password_auth; then
    printf 'PasswordAuthentication yes\nKbdInteractiveAuthentication yes\n' >"$config"
  else
    printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\n' >"$config"
  fi
  chmod 644 "$config"
  ssh-keygen -A
  sshd -t
  local effective
  effective=$(sshd -T)
  if $imager_ssh_password_auth; then
    grep -qixF 'passwordauthentication yes' <<<"$effective" || return 1
  else
    grep -qixF 'passwordauthentication no' <<<"$effective" || return 1
    grep -qixF 'kbdinteractiveauthentication no' <<<"$effective" || return 1
  fi
  systemctl enable --now sshd.service

  if command -v ufw >/dev/null 2>&1; then
    ufw limit 22/tcp comment omarchy-imager-sshd >/dev/null
    ufw reload >/dev/null
  fi
}

configure_login() {
  mkdir -p /var/lib/sddm
  printf '[Last]\nSession=omarchy.desktop\nUser=%s\n' "$username" >/var/lib/sddm/state.conf
  chown -R sddm:sddm /var/lib/sddm 2>/dev/null || true

  # Autologin straight into the desktop after first-boot setup — the owner just
  # authenticated in the form, so we don't make them retype at SDDM.
  mkdir -p /etc/sddm.conf.d
  printf '[Autologin]\nUser=%s\nSession=omarchy.desktop\n' "$username" >/etc/sddm.conf.d/autologin.conf

  # Encrypted installs keep autologin permanently (the LUKS prompt is the auth
  # boundary). Unencrypted installs autologin only this first boot, then a
  # one-shot service removes the drop-in so later boots use the normal SDDM
  # login and the disk isn't left permanently open.
  encrypted_install || install_autologin_once_cleanup
}

# Install a self-removing service that makes the autologin last exactly one
# boot — this one, where the owner just authenticated in the wizard. The unit is
# created now, but graphical.target's job for THIS boot is already computed, so
# it won't run this boot (this boot autologins). On the NEXT boot it's in the
# fresh transaction, ordered Before the display manager, so it runs before SDDM
# reads its config: it removes the autologin drop-in (that boot shows the normal
# login) and deletes its own unit and enablement symlink. Ordering Before= (not
# After=) is what makes it deterministic — no sleep/race against SDDM's startup.
install_autologin_once_cleanup() {
  local unit=omarchy-provision-autologin-once.service
  sed "s|@UNIT@|$unit|g" >"/etc/systemd/system/$unit" <<'UNIT'
[Unit]
Description=Drop the first-boot autologin before the next login
Before=display-manager.service
ConditionPathExists=/etc/sddm.conf.d/autologin.conf

[Service]
Type=oneshot
ExecStart=/usr/bin/rm -f /etc/sddm.conf.d/autologin.conf
ExecStartPost=/usr/bin/rm -f /etc/systemd/system/graphical.target.wants/@UNIT@ /etc/systemd/system/@UNIT@

[Install]
WantedBy=graphical.target
UNIT
  mkdir -p /etc/systemd/system/graphical.target.wants
  ln -sf "../$unit" "/etc/systemd/system/graphical.target.wants/$unit"
}

# Apply the owner's hostname, deferred to first boot with the rest of the user
# step, overwriting the placeholder the deferred install seeded.
configure_hostname() {
  [[ -n ${hostname:-} ]] || return 0
  hostnamectl set-hostname "$hostname"
  [[ $(hostnamectl --static) == "$hostname" ]] || return 1
  [[ $(hostnamectl --transient) == "$hostname" ]] || return 1
}

# Apply the owner's timezone, deferred to first boot with the rest of the user
# step, overwriting the placeholder (UTC) the deferred install seeded.
configure_timezone() {
  [[ -n ${timezone:-} ]] || return 0
  if ! timedatectl set-timezone "$timezone" 2>&1; then
    # Fallback only if the zone file exists, so a bad zone can't point
    # /etc/localtime at nothing and break every localtime read afterward.
    [[ -e /usr/share/zoneinfo/$timezone ]] &&
      ln -sf "/usr/share/zoneinfo/$timezone" /etc/localtime 2>&1 || true
  fi
  configure_wireless_regdom
  configure_region
}

# A deferred install from one market's media took that market's region before
# anyone chose a timezone, and left it as REGION in the form defaults. Settle it
# against the owner's choice: a timezone a region profile lists picks that
# region, Hong Kong, Macau and Taiwan are always World, and any other timezone
# keeps the media's region.
configure_region() {
  local defaults=${OMARCHY_FORM_DEFAULTS:-/etc/omarchy/form-defaults} marker=${OMARCHY_REGION_FILE:-/etc/omarchy/region}
  local pacman_conf=${OMARCHY_PACMAN_CONF:-/etc/pacman.conf} key value fallback="" region current=global profile channel
  [[ -r $defaults && -n ${timezone:-} ]] || return 0
  while IFS='=' read -r key value; do
    [[ $key == "REGION" ]] && fallback=$value
  done <"$defaults"
  [[ $fallback =~ ^[a-z]{2}$ ]] || return 0
  case "$timezone" in
    Asia/Hong_Kong | Hongkong | Asia/Macau | Asia/Macao | Asia/Taipei | ROC) region=global ;;
    *)
      region=$fallback
      for profile in "$OMARCHY_PATH"/default/regions/*/; do
        [[ -r $profile/timezones ]] && grep -qxF -- "$timezone" "$profile/timezones" && region=$(basename "$profile")
      done
      ;;
  esac
  [[ -r $marker ]] && read -r current <"$marker"
  [[ $region == "$current" ]] && return 0
  if [[ $region == "global" ]]; then
    rm -f "$marker"
  else
    printf '%s\n' "$region" >"$marker"
  fi
  # Re-render pacman for the region with the channel this machine installed.
  channel=$(sed -n 's|^Server = https://pkgs\.omarchy\.[a-z]*/\([a-z]*\)/.*|\1|p' "$pacman_conf" | head -1)
  if [[ -n $channel && -x $OMARCHY_PATH/bin/omarchy-apply-pacman ]]; then
    "$OMARCHY_PATH/bin/omarchy-apply-pacman" "$channel" "${OMARCHY_REGION_TARGET:-/}" 2>&1 || true
  fi
}

# The install's hardware step found only the UTC placeholder, which names no
# country, so the wireless regulatory domain comes from the owner's timezone
# here. No reboot follows setup, so the radios get it now the way udev applies
# it at every boot.
configure_wireless_regdom() {
  bash "$OMARCHY_PATH/install/hardware/set-wireless-regdom.sh" 2>&1 || return 0
  if omarchy-cmd-present set-wireless-regdom; then
    set-wireless-regdom 2>&1 || true
  fi
}

finalize_user() {
  local entry home shell
  entry=$(getent passwd "$username") || return 1
  home=$(cut -d: -f6 <<<"$entry")
  shell=$(cut -d: -f7 <<<"$entry")
  [[ -n $home && -d $home ]] || return 1

  runuser -u "$username" -- env \
    HOME="$home" \
    USER="$username" \
    LOGNAME="$username" \
    SHELL="${shell:-/bin/bash}" \
    OMARCHY_PATH="$OMARCHY_PATH" \
    OMARCHY_INSTALL="$OMARCHY_PATH/install" \
    OMARCHY_SETUP_CONTEXT=provision-owner \
    OMARCHY_INSTALL_LOG_FILE="$LOG_FILE" \
    OMARCHY_LOG_TO_STDOUT=1 \
    "$OMARCHY_PATH/bin/omarchy-provision-user" --force --first-install
}

# During the provisioning window the staged key rides in the UKI's initramfs,
# named on the kernel cmdline, so boot unlocks unattended.
PROVISIONING_UNLOCK_FILES=(
  /etc/omarchy/provisioning.key
  /etc/limine-entry-tool.d/99-omarchy-provisioning-unlock.conf
  /etc/mkinitcpio.conf.d/99-omarchy-provisioning-key.conf
)

limine_auto_unlock_present() {
  local file
  for file in "${PROVISIONING_UNLOCK_FILES[@]}"; do
    [[ -e $file ]] && return 0
  done
  return 1
}

# Rebuild the UKI without the embedded keyfile. A failed rebuild restores the
# auto-unlock, so the retry still boots unattended.
limine_auto_unlock_drop() {
  rm -f "${PROVISIONING_UNLOCK_FILES[@]}"
  reset_limine_config
  if limine-update >>"$LOG_FILE" 2>&1; then
    return 0
  fi

  # Once the staged key is destroyed there is no auto-unlock to restore: the
  # boot files already ask for the owner's password. The rebuild is still
  # retried for the boot entries.
  if [[ -f $PROVISIONING_DIR/luks-key ]]; then
    log_step "limine-update failed during re-key; restoring auto-unlock for retry"
    install -Dm600 "$PROVISIONING_DIR/luks-key" /etc/omarchy/provisioning.key
    echo 'KERNEL_CMDLINE[default]+=" cryptkey=rootfs:/etc/omarchy/provisioning.key"' \
      >/etc/limine-entry-tool.d/99-omarchy-provisioning-unlock.conf
    echo 'FILES+=(/etc/omarchy/provisioning.key)' >/etc/mkinitcpio.conf.d/99-omarchy-provisioning-key.conf
  else
    log_step "limine-update failed during re-key; the staged key is gone, so no auto-unlock is restored"
  fi
  limine-update >>"$LOG_FILE" 2>&1 || true
  return 1
}

# A platform whose boot package implements provision-commit and provision-verify
# stages the unlock in its own boot chain and owns it; everywhere else it rides
# in the Limine UKI above. Deciding fails closed: the unlock then counts as
# present and cannot be dropped.
UNLOCK_OWNER=""

unlock_owner() {
  [[ -z ${UNLOCK_OWNER:-} ]] || return 0

  local commit verify
  commit=$("$OMARCHY_PATH/bin/omarchy-lifecycle-dispatch" --resolve provision-commit) || return 1
  verify=$("$OMARCHY_PATH/bin/omarchy-lifecycle-dispatch" --resolve provision-verify) || return 1
  if [[ -n $commit && -n $verify ]]; then
    UNLOCK_OWNER=platform
  elif [[ -z $commit && -z $verify ]]; then
    UNLOCK_OWNER=limine
  else
    log_step "the platform implements only one of provision-commit and provision-verify"
    return 1
  fi
}

luks_auto_unlock_present() {
  unlock_owner || return 0
  if [[ $UNLOCK_OWNER == "platform" ]]; then
    ! "$OMARCHY_PATH/bin/omarchy-lifecycle-dispatch" provision-verify >>"$LOG_FILE" 2>&1
  else
    limine_auto_unlock_present
  fi
}

luks_auto_unlock_drop() {
  unlock_owner || return 1
  if [[ $UNLOCK_OWNER == "platform" ]]; then
    "$OMARCHY_PATH/bin/omarchy-lifecycle-dispatch" provision-commit >>"$LOG_FILE" 2>&1
  else
    limine_auto_unlock_drop
  fi
}

# The platform records the slot the re-key keeps, and no recovery slot; a no-op
# where nothing does.
luks_record_slots() {
  "$OMARCHY_PATH/bin/omarchy-lifecycle-dispatch" luks-slots "owner=$1" "recovery=" >>"$LOG_FILE" 2>&1
}

# Move the LUKS volume from the throwaway install passphrase to the user's
# password and retire every other slot (throwaway + any seller keys a reset
# left behind). luks_rekey journals each step, so an interrupted attempt
# resumes where it stopped.
rekey_luks() {
  luks_rekey_pending || return 0

  local device
  if ! device=$(luks_device) || [[ ! -e $device ]]; then
    log_step "cannot locate the LUKS device from /proc/cmdline: $(cat /proc/cmdline)"
    say --foreground 1 "Could not locate the LUKS device to re-key."
    return 1
  fi

  luks_rekey "$device"
}

# The re-key's fingerprint of the console keyboard layout the boot files ask for
# the disk password in: a hash of vconsole.conf's keymap and XKB settings, in
# file order since a later duplicate wins, so the journal never names the layout.
luks_boot_layout() {
  if [[ ! -f /etc/vconsole.conf ]]; then
    echo none
    return
  fi
  awk '/^[ \t]*(KEYMAP|KEYMAP_TOGGLE|XKB[A-Z_]*)=/ { sub(/^[ \t]+/, ""); print }' /etc/vconsole.conf |
    sha256sum | cut -d' ' -f1
}

# A re-key interrupted after the staged key was retired can only finish with
# the password the disk already holds.
rekey_accepts_password() {
  local -
  set +x
  local device
  [[ -f $REKEY_STATE ]] || return 0
  if ! device=$(luks_device) || [[ ! -e $device ]]; then
    return 0
  fi
  luks_rekey_accepts_password "$device"
}

# Start the ESP's limine.conf settings over from the shipped template before
# rebuilding this machine's boot entry. limine-entry-tool keys OS entries by
# machine-id, and an entry rebuilt on top of stale kernel entries would keep a
# stale UKI hash and make Limine stop at a hash-mismatch warning.
esp_path() {
  local esp=""
  if [[ -f /etc/default/limine ]]; then
    esp=$(sed -n 's/^ESP_PATH=["'\'']\?\([^"'\'']*\).*/\1/p' /etc/default/limine | tail -1)
  fi
  echo "${esp:-/boot}"
}

# Stale only if this machine has no bootable entry of its own: none at all,
# or the bare header reset_limine_config leaves when the rebuild after it
# failed. Other machine-ids are not stale: a shared ESP holds other systems'
# entries, and the factory reset already re-keyed this system's entry to the
# identity it boots with.
limine_entries_stale() {
  local esp machine_id
  esp=$(esp_path)
  machine_id=$(cat /etc/machine-id 2>/dev/null || true)
  [[ -f $esp/limine.conf && -n $machine_id ]] || return 1
  ! awk -v id="$machine_id" '
    /^\/[^\/]/ { mine = 0 }
    $0 ~ ("^comment: machine-id=" id "([[:space:]]|$)") { mine = 1 }
    mine && /^[[:space:]]*[a-z_]*path:/ { bootable = 1 }
    END { exit !bootable }
  ' "$esp/limine.conf"
}

# Only this machine's own entry is emptied for limine-update to rebuild in
# place, where default_entry points. Every other entry and machine-id
# directory stays: on a shared ESP they belong to other systems (Windows,
# other Linux installs), and nothing here can tell them from our own leftovers.
reset_limine_config() {
  local esp template="" candidate machine_id entries=""
  esp=$(esp_path)

  for candidate in "$OMARCHY_PATH/install/assets/limine/limine.conf" \
                   "$OMARCHY_PATH/default/limine/limine.conf"; do
    if [[ -f $candidate ]]; then
      template=$candidate
      break
    fi
  done
  if [[ -z $template ]]; then
    log_step "no limine.conf template found; keeping the existing config"
    return 0
  fi

  machine_id=$(cat /etc/machine-id 2>/dev/null || true)
  if [[ -f $esp/limine.conf ]]; then
    # Same rewrite as omarchy-system-factory-reset, keyed to this identity:
    # this machine's entry keeps only its header, and any copy after the first
    # is dropped. An entry-less config passes through as is.
    entries=$(awk -v id="$machine_id" '
      function flush() {
        if (is_ours && !kept) { printf "%s\n", header; kept = 1 }
        else if (!is_ours) printf "%s", block
        block = header = ""; is_ours = nested = 0
      }
      /^\/[^\/]/ { flush(); in_entry = 1 }
      !in_entry { next }
      {
        if (id != "" && /^comment: machine-id=/ && $0 ~ ("machine-id=" id "([[:space:]]|$)")) is_ours = 1
        if (/^[[:space:]]*\/\//) nested = 1
        block = block $0 "\n"
        if (!nested) header = header $0 "\n"
      }
      END { flush() }
    ' "$esp/limine.conf")
  fi

  { cat "$template"; [[ -z $entries ]] || printf '%s\n' "$entries"; } >"$esp/limine.conf.new"
  mv "$esp/limine.conf.new" "$esp/limine.conf"
}

cleanup_oem_state() {
  # Keep groups + packages: omarchy-system-factory-reset stages the bundled Node
  # tarball from these live copies when the factory snapshot predates it.
  if [[ -f $IMAGER_STATE_DIR/receipt.json ]]; then
    install -Dm600 "$IMAGER_STATE_DIR/receipt.json" /var/lib/omarchy/imager-preseed.json
  fi
  rm -f "$PROVISIONING_DIR/authorized_keys" \
    /boot/rpi-preseed.toml /boot/firmware/rpi-preseed.toml
  rm -rf "$IMAGER_STATE_DIR"

  # Retain the pinned account and re-key journal until the completion gate is
  # removed. Interrupted credential cleanup must still resume the same owner.
  rm -f "$PROVISIONING_DIR/pending"
  rm -f "$PROVISIONING_DIR/setup-user" "$PROVISIONING_DIR/account-created" "$REKEY_STATE" "$FINALIZE_WARNING_FLAG" \
    /etc/systemd/system/multi-user.target.wants/omarchy-provision-owner.service ||
    log_step "setup is complete; some completed provisioning checkpoints could not be removed"
  systemctl daemon-reload 2>/dev/null || true
}

# The provisioning work, backgrounded under the progress screen. Phase writes
# to STATE_FILE drive the progress; all output lands in the log.
run_provisioning() {
  local status account
  log_step "setting hostname to ${hostname:-omarchy}"
  configure_hostname

  if [[ -f $PROVISIONING_DIR/account-created ]]; then
    account=$(<"$PROVISIONING_DIR/account-created")
    if [[ $account != "$username" ]] || ! getent passwd "$username" >/dev/null; then
      log_step "the saved owner account is unavailable; refusing to create another account"
      return 1
    fi
    log_step "continuing setup for user $username"
  else
    log_step "creating user $username"
    create_user
    printf '%s\n' "$username" >"$PROVISIONING_DIR/account-created.new"
    mv "$PROVISIONING_DIR/account-created.new" "$PROVISIONING_DIR/account-created"
  fi
  configure_password
  install_authorized_keys
  configure_imager_network
  configure_imager_ssh

  log_step "setting timezone to ${timezone:-UTC}"
  configure_timezone

  log_step "finalizing user"
  echo finalize >"$STATE_FILE"
  if finalize_user; then
    rm -f "$FINALIZE_WARNING_FLAG"
  else
    status=$?
    log_step "finalize-user failed (exit code: $status); owner setup remains pending"
    touch "$FINALIZE_WARNING_FLAG"
    return "$status"
  fi

  if luks_rekey_pending; then
    log_step "re-keying LUKS to the user's password"
    echo rekey >"$STATE_FILE"
    rekey_luks
    log_step "LUKS re-key complete"
  fi

  # On an unencrypted machine nothing above rebuilds the boot entries. The
  # factory reset already keyed them to this identity, so this only repairs a
  # machine left without an entry of its own.
  if limine_entries_stale; then
    log_step "refreshing boot entries for the new machine identity"
    echo boot >"$STATE_FILE"
    reset_limine_config
    limine-update
  fi

  if luks_staged_unlock_remains; then
    log_step "refusing to finish setup while the staged LUKS key or its auto-unlock remains"
    return 1
  fi

  configure_login
  log_step "cleaning up provisioning state"
  cleanup_oem_state
  log_step "first-boot setup complete"
}

# Where the platform's boot package owns the boot chain, it must be ready to
# finish setup, and able to record the kept key slot, before the owner is asked
# anything.
platform_ready() {
  local error
  # Unit ordering cannot protect a manual retry, and Before= alone does not
  # propagate failure. The hardware runner serializes with its first-boot
  # service and does nothing once its deferred work is complete.
  if error=$("$OMARCHY_PATH/bin/omarchy-provision-hardware" 2>&1 >>"$LOG_FILE") &&
    error=$("$OMARCHY_PATH/bin/omarchy-lifecycle-dispatch" provision-prepare 2>&1 >>"$LOG_FILE") &&
    error=$("$OMARCHY_PATH/bin/omarchy-lifecycle-dispatch" --resolve luks-slots 2>&1 >/dev/null); then
    return 0
  fi
  error=${error:-"Required hardware or boot setup could not prepare this machine for owner setup."}

  log_step "required hardware or boot setup is not ready: $error"
  clear_logo
  echo
  say --foreground 1 "$error"
  sleep 5
  return 1
}

run_setup() {
  local status

  platform_ready || return 1

  while true; do
    keyboard_form || return 1
    user_form && status=0 || status=$?
    if ((status != 0)); then
      # Esc unwinds to the keyboard step. Ctrl+C is the only other way out of a
      # prompt, and it offers the reboot instead of returning a value.
      ((status == OMARCHY_FORM_SIGNAL)) && confirm_reboot && exec systemctl reboot
      continue
    fi
    confirm_form || continue
    if ! rekey_accepts_password; then
      notice "Setup already set the disk password. Enter that same password." 4
      continue
    fi
    break
  done

  touch "$LOG_FILE"
  chmod 600 "$LOG_FILE"

  echo account >"$STATE_FILE"

  run_provisioning >>"$LOG_FILE" 2>&1 &
  local worker=$!

  set_now
  SETUP_T0=$NOW
  SETUP_PHASE_T0=$NOW

  render_setup_static
  # Read the phase and the log at 2 Hz; animate the trace at 10 Hz, as the ISO
  # install dashboard does.
  local frame=0
  while kill -0 "$worker" 2>/dev/null; do
    render_setup_dynamic "$((frame % 5 == 0))"
    frame=$((frame + 1))
    sleep 0.1
  done

  # The cursor comes back only on the failure path, where the retry prompt needs
  # it. A clean run keeps it hidden through the last frame and the handoff.
  local status=0
  wait "$worker" || status=$?
  if (( status != 0 )); then
    printf '%s' "$SHOW_CURSOR"
    return "$status"
  fi

  # Finish the trace and show the solid icon, so the handoff doesn't cut in
  # mid-progress.
  echo "done" >"$STATE_FILE"
  render_setup_finish
  sleep 1

  # Deferred first boot hands straight off to the display manager: SDDM starts
  # the moment this oneshot exits (Before=display-manager.service) and autologs
  # in on encrypted installs. No timed celebration screen and no "start" button
  # here — that send-off belongs to a direct install, not first-boot setup. The
  # finished progress bar is the last frame; clearing it for a "Starting
  # Omarchy..." card would only add a flash of screen before the handoff.
}

run_imager_setup() {
  platform_ready || return 1
  apply_keyboard "$keyboard"
  touch "$LOG_FILE"
  chmod 600 "$LOG_FILE"
  echo account >"$STATE_FILE"

  run_provisioning >>"$LOG_FILE" 2>&1 &
  local worker=$!
  set_now
  SETUP_T0=$NOW
  SETUP_PHASE_T0=$NOW
  render_setup_static
  while kill -0 "$worker" 2>/dev/null; do
    render_setup_dynamic
    sleep 0.5
  done

  local status=0
  wait "$worker" || status=$?
  if (( status != 0 )); then
    printf '%s' "$SHOW_CURSOR"
    return "$status"
  fi
  echo "done" >"$STATE_FILE"
  render_setup_dynamic
  sleep 1
}

# A failed first-boot setup must not strand the machine at a user-less login
# screen. Each attempt runs as its own process — bash ignores errexit inside
# `while !` conditions, but a child process keeps its own set -e — and failure
# offers a retry; create_user and friends are idempotent, so retrying is safe.
if [[ ${1:-} == "--attempt" ]]; then
  run_setup
  exit 0
fi

# Keep errexit active throughout unattended setup. Calling its functions from
# an if condition suppresses failures deep inside account/hostname setup.
if [[ ${1:-} == "--imager-attempt" ]]; then
  load_imager_preseed
  run_imager_setup
  exit 0
fi

main() {
  # Font sizing waits for the console to settle, so it lives inside
  # greeter_screen (which owns that settle) rather than running here on a VT
  # that may still be in a transitional mode this early in first boot.
  set_tokyo_night_colors
  if load_imager_preseed; then
    if "$0" --imager-attempt; then
      return 0
    fi
    clear_logo
    say --foreground 1 "Raspberry Pi Imager setup failed; setup remains pending (see $LOG_FILE)."
    say "Continuing with interactive setup for this account."
    sleep 3
  fi
  greeter_screen

  while ! "$0" --attempt; do
    clear_logo
    echo
    say --foreground 1 "Setup hit an error (details in $LOG_FILE)."
    echo
    if ! gum confirm --affirmative "Try again" --negative "Drop to console" "Retry first-boot setup?"; then
      # Give an actual usable console: this service owns tty1 (and Conflicts the
      # getty), and on a failed deferred setup there's no user account and root
      # is locked — so exiting would strand the machine with no way in. Exec a
      # root shell on tty1. Keep the service failed if pending still exists,
      # so SDDM cannot start after a failed or abandoned finalization.
      say "Dropping to a root shell. Run 'omarchy-provision-owner' to retry setup."
      /bin/bash
      [[ ! -f $PROVISIONING_DIR/pending ]] || return 1
    fi
  done
}

main
