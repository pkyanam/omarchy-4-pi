#!/bin/bash

# omarchy:summary=Rebuild the locally packaged Raspberry Pi port after its source checkout advances
# omarchy:hidden=true

set -euo pipefail

profile="${OMARCHY_RPI4_PROFILE:-/etc/omarchy-rpi4.conf}"
omarchy-update-rpi4-guard
# shellcheck source=/dev/null
source "$profile"

checkout="${OMARCHY_RPI4_SOURCE:-}"
[[ -n $checkout && -d $checkout/.git ]] || {
  echo "Warning: Raspberry Pi Omarchy source checkout is unavailable; skipping the core update." >&2
  exit 0
}

upstream=$(git -C "$checkout" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
[[ -n $upstream ]] || {
  echo "Raspberry Pi Omarchy checkout has no upstream; keeping the installed core."
  exit 0
}

git -C "$checkout" diff --quiet && git -C "$checkout" diff --cached --quiet || {
  echo "Warning: Raspberry Pi Omarchy checkout has local changes; skipping the core update." >&2
  exit 0
}

git -C "$checkout" fetch --quiet origin refs/heads/main:refs/remotes/origin/main
behind=$(git -C "$checkout" rev-list --count "HEAD..$upstream")
if (( behind > 0 )); then
  git -C "$checkout" merge --ff-only "$upstream"
fi

# A failed build must remain retryable after the checkout has advanced.
# HEAD alone does not prove that its packages were installed successfully.
state_file=${OMARCHY_RPI4_UPDATE_STATE:-/var/lib/omarchy/rpi4-source-commit}
source_commit=$(git -C "$checkout" rev-parse HEAD)
installed_commit=""
[[ ! -r $state_file ]] || installed_commit=$(<"$state_file")
[[ $installed_commit != "$source_commit" ]] || {
  echo "Raspberry Pi Omarchy core is up to date."
  exit 0
}

# Minimal still includes runtime dependencies such as the screensaver renderer.
# Reuse the package-only leaves, never replay owner provisioning or reset config.
(
  source "$checkout/install-rpi4.sh"
  # shellcheck disable=SC2034
  install_mode=minimal
  ensure_package_sources
  install_arm_packages
)

output=$(mktemp -d)
trap 'rm -rf "$output"' EXIT
OMARCHY_PACKAGE_OUTPUT="$output" "$checkout/build-packages-rpi4.sh"

packages=()
for package in "$output"/*.pkg.tar.*; do
  [[ -f $package && $package != *.sig ]] && packages+=("$package")
done
(( ${#packages[@]} )) || {
  echo "Error: Raspberry Pi core rebuild produced no packages." >&2
  exit 1
}
sudo pacman -U --noconfirm "${packages[@]}"
sudo install -d "$(dirname "$state_file")"
printf '%s\n' "$source_commit" | sudo tee "$state_file" >/dev/null
