#!/bin/bash

# omarchy:summary=Print the active Omarchy mirror and package channel

if [[ -f /etc/omarchy-rpi4.conf ]]; then
  if omarchy-update-rpi4-guard packages >/dev/null 2>&1; then
    echo "rpi4 (stable ARM)"
  else
    echo "rpi4 (unsupported package policy; recovery required)"
  fi
  exit 0
fi

# Arch Linux ARM mirrors share the channel hosts with an arm- prefix.
if grep -Eq "https://(arm-)?stable-mirror\.omarchy\.org/" /etc/pacman.d/mirrorlist; then
  mirror="stable"
elif grep -Eq "https://(arm-)?rc-mirror\.omarchy\.org/" /etc/pacman.d/mirrorlist; then
  mirror="rc"
elif grep -Eq "https://(arm-)?mirror\.omarchy\.org/" /etc/pacman.d/mirrorlist; then
  mirror="edge"
else
  mirror="unknown"
fi

if grep -q "https://pkgs.omarchy.org/stable/" /etc/pacman.conf; then
  pkgs="stable"
elif grep -q "https://pkgs.omarchy.org/rc/" /etc/pacman.conf; then
  pkgs="rc"
elif grep -q "https://pkgs.omarchy.org/edge/" /etc/pacman.conf; then
  pkgs="edge"
else
  pkgs="unknown"
fi

if [[ $mirror == "$pkgs" ]]; then
  echo $mirror
else
  echo "$mirror / $pkgs"
fi
