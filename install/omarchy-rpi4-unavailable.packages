# Explicit Pi 4 scope exclusions, shared by fresh installs and updates.
# Runtime entries absent from the signed stable repositories are errors unless
# explicitly optional in omarchy-rpi4.packages. Never add names to hide failures.

# Apple-only hardware control cannot apply to a Pi.
asdcontrol

# Emulated foreign-architecture containers are outside this Pi 4 image budget.
qemu-user-static-binfmt

# The Pi encoder path is not verified; wf-recorder preserves recording.
gpu-screen-recorder

# Static backgrounds are the Pi default. The local core recipe deliberately
# removes this hard dependency, while an explicit later install stays possible.
omarchy-themes-intros
