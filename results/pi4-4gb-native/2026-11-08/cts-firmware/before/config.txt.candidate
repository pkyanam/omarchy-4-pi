arm_64bit=1
arm_boost=1
enable_uart=1
uart_2ndstage=1
enable_gic=1
armstub=RPI_EFI.fd
disable_commandline_tags=1
disable_overscan=1
device_tree_address=0x3e0000
device_tree_end=0x400000
dtoverlay=miniuart-bt
dtoverlay=upstream-pi4

# Match upstream Linux BCM2835 DMA mappings for the Pi 4 HDMI driver.
dtoverlay=omarchy-pi4-mainline-dma

# Mainline AUX hardware flow control; paired with linux-omarchy 7.3-32.2.
dtoverlay=omarchy-pi4-aux-rtscts
