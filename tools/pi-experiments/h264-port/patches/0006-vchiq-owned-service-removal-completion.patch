+ * transport must outlive remove_sync. Never call from a transport callback.
+ * retired excludes new lookups; released drains ALL service references, including
+ * callback/slot/sync handlers. Neither completion proves firmware DMA cessation.
+ */
+struct vchiq_service_owner {
+	struct vchiq_service *service;
+	struct completion retired;
+	struct completion released;
