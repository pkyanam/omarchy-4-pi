+/* The owner pin is installed before the service becomes discoverable. Failed
+ * OPEN also drains callbacks before returning its userdata to the caller.
+ */
+int vchiq_open_service_owned(struct vchiq_instance *instance,
+	const struct vchiq_service_params_kernel *params, unsigned int *phandle,
+	struct vchiq_service_owner *owner)
+{
+	struct vchiq_service *service;
+	int ret;
+
+	owner->service = NULL;
+	*phandle = VCHIQ_SERVICE_HANDLE_INVALID;
+	if (!vchiq_is_connected(instance))
+		return -ENOTCONN;
+	service = vchiq_add_service_internal_owned(instance->state, params,
+		VCHIQ_SRVSTATE_OPENING, instance, NULL, owner);
+	if (!service)
+		return -EINVAL;
+	ret = vchiq_open_service_internal(service, current->pid);
+	if (ret) {
+		vchiq_remove_service_sync(owner);
+		return ret;
+	}
+	*phandle = service->handle;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(vchiq_open_service_owned);
