+/* Unlike handle-based close, the owner pin survives FREE/handle retirement.
+ * Removal is driven by the slot handler, which owns close state transitions.
+ * There is no interruptible wait or EINVAL-as-success shortcut. A wedged peer
+ * can block forever: caller must retain its transport/userdata until it drains.
+ */
+void vchiq_remove_service_sync(struct vchiq_service_owner *owner)
+{
+	struct vchiq_service *service = owner->service;
+
+	if (!service)
+		return;
+	WARN_ON(current == service->state->slot_handler_thread);
+	if (READ_ONCE(service->srvstate) != VCHIQ_SRVSTATE_FREE) {
+		mark_service_closing(service);
+		request_poll(service->state, service, VCHIQ_POLL_REMOVE);
+	}
+	wait_for_completion(&owner->retired);
+	owner->service = NULL;
+	vchiq_service_put(service);
+	wait_for_completion(&owner->released);
+}
+EXPORT_SYMBOL_GPL(vchiq_remove_service_sync);
 
