+
+static void vc_sm_generation_release(struct kref *ref)
+{
+	struct vc_sm_generation *generation =
+		container_of(ref, struct vc_sm_generation, refs);
+
+	kfree(generation);
+}
+
+static void vc_sm_generation_put(struct vc_sm_generation *generation)
+{
+	kref_put(&generation->refs, vc_sm_generation_release);
+}
+
+/* Caller holds sm_admission_lock for the entire operation. */
+static bool vc_sm_file_ready(struct vc_sm_privdata_t *private)
+{
+	return private && private->generation->ready;
+}
+
+/* This private transport has no unrelated services. Owned SMIO init failure
+ * drains all opened services before returning NULL, per 0006/0007. Shutdown
+ * here therefore frees a service-free instance, not a DMA quiescence proof.
+ */
+static int vc_sm_connect(struct sm_state_t *state)
+{
+	struct vchiq_drv_mgmt *mgmt = dev_get_drvdata(state->device->dev.parent);
+	int ret;
+
+	ret = vchiq_initialise(&mgmt->state, &state->vchiq_instance);
+	if (ret)
+		return ret;
+	ret = vchiq_connect(state->vchiq_instance);
+	if (!ret) {
+		state->sm_handle = vc_sm_cma_vchi_init(state->vchiq_instance, 1,
+						    vc_sm_vpu_event);
+		if (!state->sm_handle)
+			ret = -ENODEV;
+	}
+	if (ret) {
+		vchiq_shutdown(state->vchiq_instance);
+		state->vchiq_instance = NULL;
+	}
+	return ret;
+}
 
