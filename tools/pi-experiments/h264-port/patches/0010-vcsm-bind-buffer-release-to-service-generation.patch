+/* The bound driver owns state/devm storage until remove's buffer drain and
+ * worker join finish. No get_device-only or asynchronous module self-pin is
+ * used: neither would protect devm state or a callback's return instruction.
+ */
+static void vc_sm_buffer_init(struct vc_sm_buffer *buffer, struct sm_state_t *state)
+{
+	buffer->owner = state;
+	INIT_LIST_HEAD(&buffer->global_buffer_list);
+	atomic_inc(&state->live_buffers);
+}
+
+static void vc_sm_buffer_destroy(struct vc_sm_buffer *buffer)
+{
+	struct sm_state_t *state = buffer->owner;
+
+	kfree(buffer);
+	mutex_lock(&state->map_lock);
+	atomic_dec(&state->live_buffers);
+	wake_up_all(&state->buffer_drain);
+	mutex_unlock(&state->map_lock);
+}
