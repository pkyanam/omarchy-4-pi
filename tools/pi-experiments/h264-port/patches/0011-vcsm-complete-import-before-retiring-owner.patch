 /* Import a dma_buf to be shared with VC. */
+/* Runs on SMIO before completion and before the next firmware event. The
+ * producer owns in_use until export or error retirement, so early RELEASED
+ * cannot destroy a buffer still being set up by its caller.
+ */
+static void vc_sm_import_done(void *context, u32 handle)
+{
+	struct vc_sm_buffer *buffer = context;
+
+	mutex_lock(&buffer->owner->kernelid_map_lock);
+	mutex_lock(&buffer->lock);
+	buffer->import_pending = false;
+	if (handle && handle == buffer->early_release) {
+		/* RELEASED can precede the response; only its confirmed handle
+		 * authorizes retirement. The producer still owns in_use.
+		 */
+		idr_remove(&buffer->owner->kernelid_map, buffer->kernel_id);
+		handle = 0;
+	}
+	buffer->vc_handle = handle;
+	buffer->vpu_state = handle ? VPU_MAPPED : VPU_NOT_MAPPED;
+	mutex_unlock(&buffer->lock);
+	mutex_unlock(&buffer->owner->kernelid_map_lock);
+}
+
+/* No publication or definitive rejection: remove the local ID. Successful
+ * publication: FREE and retain the ID/mapping until real RELEASED.
+ */
+static void vc_sm_import_unpublish(struct vc_sm_buffer *buffer)
+{
+	struct sm_state_t *state = buffer->owner;
+
+	mutex_lock(&state->kernelid_map_lock);
+	mutex_lock(&buffer->lock);
+	if (!buffer->vc_handle && buffer->kernel_id > 0)
+		idr_remove(&state->kernelid_map, buffer->kernel_id);
+	mutex_unlock(&buffer->lock);
+	mutex_unlock(&state->kernelid_map_lock);
+}
+
+static void vc_sm_import_abort(struct vc_sm_buffer *buffer)
+{
+	vc_sm_import_unpublish(buffer);
+	mutex_lock(&buffer->lock);
+	buffer->in_use = false;
+	buffer->setup_pending = false;
+	vc_sm_vpu_free(buffer);
+	vc_sm_release_resource(buffer);
+}
+
+static void vc_sm_import_finish(struct vc_sm_buffer *buffer)
+{
+	mutex_lock(&buffer->lock);
+	buffer->setup_pending = false;
+	vc_sm_release_resource(buffer);
+}
